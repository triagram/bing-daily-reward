# Phone push for the daily run's alerts — optional. The desktop notification is always
# sent; this file only adds a phone. Copy it to ~/.config/bing-daily-reward/alert.env,
# chmod 600, and fill in one channel or both. The same sentence goes to every channel
# that is configured, and it never carries a point figure.
#
# Read as shell: NAME=value, no spaces around '=', no quotes needed.
# Setup and troubleshooting: contrib/systemd/README.md, "Phone push (optional)".

# Telegram — a bot made with @BotFather, and the id of your own chat with it.
# The id is the "chat":{"id":…} field of getUpdates, not update_id.
#TELEGRAM_BOT_TOKEN=123456789:AAH...
#TELEGRAM_CHAT_ID=123456789

# ntfy — a long random topic name, subscribed to in the ntfy app. No account; the name
# is the only secret.
#NTFY_TOPIC=
