[Unit]
Description=Microsoft Rewards daily run
# Any non-zero exit: 1 crashed, 2 ran with flags, 3 sign-in needed, 4 profile busy,
# 5 no desktop session within the wait window.
OnFailure=rewards-alert.service

[Service]
Type=oneshot
# The wrapper waits (up to three hours) for the desktop session's display, then runs
# the bot in it. The user manager lingers, so the timer fires logged-in or not; the
# window the bot opens needs a session. See the script.
# No paths here: %Y is this file's real directory once linked, and the wrapper runs
# the bot from the repository root, so the clone can live anywhere.
ExecStart=%Y/run-with-display.sh %h/.local/bin/uv run python rewards_bot.py
# After every exit, clean or not: the day's report to the phone channels, rendered
# from the run just recorded. A run that stopped before recording one (sign-in, busy
# profile, no desktop) has no report, and OnFailure= speaks for it instead.
ExecStopPost=%Y/rewards-alert.sh report
# Three hours of waiting, then a run of ten to fifteen minutes, plus up to five
# waiting for a busy profile.
TimeoutStartSec=14400
