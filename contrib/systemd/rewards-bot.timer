[Unit]
Description=Run the Rewards tasks once a day, in the morning

[Timer]
# 09:30 plus up to three hours: somewhere in 09:30-12:30 local, different every day.
# The reset is midnight UTC (Q3), so even the earliest start is hours into the day.
# 09:30 rather than 07:30 since 2026-10-02: the two featured-topic cards on /earn rotate
# between 08:49 and 09:19 local (07:49-08:19 UTC), and a run before the rotation only
# sees the previous day's pair - a pair is lost whenever such a run is followed by one
# after the rotation (09-25/26, 20 points). Winter time moves the rotation earlier in
# local terms, not later, so 09:30 holds through the clock change. Evidence in
# docs/DEVELOP.md, "A keep-earning card credited more than five minutes after its click".
OnCalendar=*-*-* 09:30:00
RandomizedDelaySec=3h
# A day the machine was off is run at the next login. Catch-up is for a day that did
# not run at all: the flag-gated tasks are idempotent, but the search task adds a second
# burst to a day that already ran (README.md, "Do not run it a second time"). So stamp
# the timer before enabling or re-timing it, as contrib/systemd/README.md says.
Persistent=true

[Install]
WantedBy=timers.target
