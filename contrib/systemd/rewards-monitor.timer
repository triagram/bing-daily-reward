[Unit]
Description=Sample Rewards state four times a day

[Timer]
# Reset is midnight UTC (Q3, resolved). 06:00 local is safely into the new day.
OnCalendar=*-*-* 06:00:00
OnCalendar=*-*-* 12:00:00
OnCalendar=*-*-* 18:00:00
OnCalendar=*-*-* 23:30:00
# Catch up a sample missed while the machine was off.
Persistent=true
# Wide jitter. Four dashboard loads at the same four times every day is a pattern in
# itself, even though each load is something any user does. 90 minutes keeps the
# morning/midday/evening/night coverage while scattering when they actually land.
RandomizedDelaySec=5400

[Install]
WantedBy=timers.target
